{
  "name": "leptos-flow",
  "version": "0.1.0",
  "description": "A Rust-based flow editor with WASM rendering",
  "private": true,
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "build:wasm": "cd examples/simple-flow && wasm-pack build --target web --out-dir pkg --dev",
    "build:wasm:release": "cd examples/simple-flow && wasm-pack build --target web --out-dir pkg --release",
    "serve": "cd examples/simple-flow && python3 -m http.server 8080",
    "dev": "concurrently \"npm run build:wasm\" \"npm run serve\"",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "fmt": "cargo fmt --all",
    "test": "cargo test --all-targets --all-features",
    "check": "cargo check --all-targets --all-features"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "rust",
    "wasm",
    "flow-editor",
    "canvas2d",
    "leptos",
    "graph-editor"
  ],
  "author": "Leptos Flow Contributors",
  "license": "MIT"
}
